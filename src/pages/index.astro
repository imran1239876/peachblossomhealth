---
/**
 * Home page — Peach Blossom Direct Primary Care.
 *
 * Static HTML; the only JavaScript is src/scripts/home.ts (hero explorer,
 * scroll reveals, FAQ), bundled as one small module. No React island ships.
 * Sections live in src/components/home/ in page order; brand styles are in
 * src/styles/peach.css.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/home/Hero.astro";
import MeetDoctor from "@/components/home/MeetDoctor.astro";
import Services from "@/components/home/Services.astro";
import WeightManagement from "@/components/home/WeightManagement.astro";
import WhatIsDpc from "@/components/home/WhatIsDpc.astro";
import MembershipBenefits from "@/components/home/MembershipBenefits.astro";
import Pricing from "@/components/home/Pricing.astro";
import Testimonials from "@/components/home/Testimonials.astro";
import Credentials from "@/components/home/Credentials.astro";
import Employers from "@/components/home/Employers.astro";
import Faq from "@/components/home/Faq.astro";
import Contact from "@/components/home/Contact.astro";
import Newsletters from "@/components/home/Newsletters.astro";
import ClosingCta from "@/components/home/ClosingCta.astro";
---

<BaseLayout
  description="Family medicine and weight management in Bear, DE with Dr. Rabia Qureshi, MD. Membership from $60 a month. Book a free Meet & Greet."
>
  <Hero />
  <MeetDoctor />
  <Services />
  <WeightManagement />
  <WhatIsDpc />
  <MembershipBenefits />
  <Pricing />
  <Testimonials />
  <Credentials />
  <Employers />
  <Faq />
  <Contact />
  <Newsletters />
  <ClosingCta />
</BaseLayout>

<script>
  import "@/scripts/home";
</script>
