---
/**
 * The site's 24px line-icon sprite. Rendered once per page (by Header) so
 * every icon is a tiny <use> reference instead of repeated inline paths.
 * Strokes follow currentColor. Render icons with <Icon name="…" />.
 */
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-check" viewBox="0 0 24 24"
      ><path
        d="M5 12.5l4.2 4.2L19 7"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path></symbol
    >
    <symbol id="i-arrow" viewBox="0 0 24 24"
      ><path
        d="M5 12h14M13 6l6 6-6 6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path></symbol
    >
    <symbol id="i-phone" viewBox="0 0 24 24"
      ><path
        d="M6.6 3.5h2.6l1.4 4-2 1.3a12 12 0 0 0 6.6 6.6l1.3-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"></path></symbol
    >
    <symbol id="i-pin" viewBox="0 0 24 24"
      ><path
        d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"></path><circle
        cx="12"
        cy="10"
        r="2.4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"></circle></symbol
    >
    <symbol id="i-mail" viewBox="0 0 24 24"
      ><rect
        x="3.5"
        y="5.5"
        width="17"
        height="13"
        rx="2"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"></rect><path
        d="M4 7l8 6 8-6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"></path></symbol
    >
    <symbol id="i-fax" viewBox="0 0 24 24"
      ><path
        d="M7 9V4h10v5M7 17H5a1.5 1.5 0 0 1-1.5-1.5v-5A1.5 1.5 0 0 1 5 9h14a1.5 1.5 0 0 1 1.5 1.5v5A1.5 1.5 0 0 1 19 17h-2M7 14h10v6H7z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"></path></symbol
    >
    <symbol id="i-message" viewBox="0 0 24 24"
      ><path
        d="M4 5.5h16v10H9l-5 4v-14z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"></path><path
        d="M8 9.5h8M8 12.5h5"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"></path></symbol
    >
    <symbol id="i-calendar" viewBox="0 0 24 24"
      ><rect
        x="3.5"
        y="5"
        width="17"
        height="15"
        rx="2.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"></rect><path
        d="M3.5 10h17M8 3v4M16 3v4"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"></path></symbol
    >
    <symbol id="i-shield" viewBox="0 0 24 24"
      ><path
        d="M12 3.5l7 2.6v5.4c0 4.6-3 7.8-7 9-4-1.2-7-4.4-7-9V6.1z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"></path><path
        d="M8.8 12l2.2 2.2 4.2-4.4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"></path></symbol
    >
    <symbol id="i-award" viewBox="0 0 24 24"
      ><circle
        cx="12"
        cy="9"
        r="5.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"></circle><path
        d="M8.5 13.5L7 21l5-2.6 5 2.6-1.5-7.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"></path></symbol
    >
    <symbol id="i-clock" viewBox="0 0 24 24"
      ><circle
        cx="12"
        cy="12"
        r="8.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"></circle><path
        d="M12 7.5V12l3 2"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"></path></symbol
    >
    <symbol id="i-heart" viewBox="0 0 24 24"
      ><path
        d="M12 19.5s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 6.9a4.3 4.3 0 0 1 7.5 2.6c0 5.4-7.5 10-7.5 10z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"></path></symbol
    >
    <symbol id="i-star" viewBox="0 0 24 24"
      ><path
        d="M12 3.8l2.5 5.1 5.6.8-4 3.9 1 5.6-5.1-2.7-5 2.7 1-5.6-4-3.9 5.5-.8z"
        fill="currentColor"></path></symbol
    >
    <symbol id="i-menu" viewBox="0 0 24 24"
      ><path
        d="M4 7h16M4 12h16M4 17h16"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"></path></symbol
    >
    <symbol id="i-chevron" viewBox="0 0 24 24"
      ><path
        d="M7 10l5 5 5-5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path></symbol
    >
    <symbol id="i-blossom-line" viewBox="0 0 100 100"
      ><g fill="none" stroke="currentColor" stroke-width=".35"
        ><ellipse cx="50" cy="26" rx="11" ry="23"></ellipse><ellipse
          cx="50"
          cy="26"
          rx="11"
          ry="23"
          transform="rotate(60 50 50)"></ellipse><ellipse
          cx="50"
          cy="26"
          rx="11"
          ry="23"
          transform="rotate(120 50 50)"></ellipse><ellipse
          cx="50"
          cy="26"
          rx="11"
          ry="23"
          transform="rotate(180 50 50)"></ellipse><ellipse
          cx="50"
          cy="26"
          rx="11"
          ry="23"
          transform="rotate(240 50 50)"></ellipse><ellipse
          cx="50"
          cy="26"
          rx="11"
          ry="23"
          transform="rotate(300 50 50)"></ellipse><circle cx="50" cy="50" r="5"
        ></circle></g
      ></symbol
    >
    <symbol id="i-blossom" viewBox="0 0 100 100"
      ><g fill="currentColor"
        ><ellipse cx="50" cy="26" rx="11" ry="23"></ellipse><ellipse
          cx="50"
          cy="26"
          rx="11"
          ry="23"
          transform="rotate(60 50 50)"></ellipse><ellipse
          cx="50"
          cy="26"
          rx="11"
          ry="23"
          transform="rotate(120 50 50)"></ellipse><ellipse
          cx="50"
          cy="26"
          rx="11"
          ry="23"
          transform="rotate(180 50 50)"></ellipse><ellipse
          cx="50"
          cy="26"
          rx="11"
          ry="23"
          transform="rotate(240 50 50)"></ellipse><ellipse
          cx="50"
          cy="26"
          rx="11"
          ry="23"
          transform="rotate(300 50 50)"></ellipse></g
      ></symbol
    >
  </defs>
</svg>
