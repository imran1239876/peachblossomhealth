---
/** Dr. Qureshi's credentials, placed alongside her homepage introduction. */
import { Image } from "astro:assets";
import abom from "@/assets/home/cert-abom.webp";
import acls from "@/assets/home/cert-acls.webp";
import abfm from "@/assets/home/cert-abfm.webp";
import aafp from "@/assets/home/cert-aafp.webp";
import hardbat from "@/assets/home/partner-hardbat-athletics.webp";

const credentials = [
  {
    src: abfm,
    name: "Family medicine",
    organization: "American Board of Family Medicine",
    category: "Board certification",
    compact: true,
  },
  {
    src: abom,
    name: "Obesity medicine",
    organization: "American Board of Obesity Medicine",
    category: "Board certification",
    compact: false,
  },
  {
    src: aafp,
    name: "Family physicians",
    organization: "American Academy of Family Physicians",
    category: "Professional membership",
    compact: false,
  },
  {
    src: acls,
    name: "Advanced cardiac life support",
    organization: "ACLS authorized provider, American Heart Association",
    category: "ACLS provider",
    compact: true,
  },
  {
    src: hardbat,
    name: "Hardbat Athletics",
    organization: "Hardbat Athletics",
    category: "Community partner",
    compact: true,
    href: "https://www.hardbatathletics.com/",
  },
];
---

<section class="credentials" aria-labelledby="credentials-title">
  <div class="container">
    <div class="credentials-heading">
      <div>
        <span class="label">Certifications, memberships &amp; partners</span>
        <h2 id="credentials-title">The expertise behind your care.</h2>
      </div>
      <p>
        Dr. Qureshi is board certified in both family medicine and obesity
        medicine.
      </p>
    </div>
    <ul class="credentials-grid">
      {
        credentials.map((credential) => (
          <li class="credential">
            <div class="credential-logo">
              <Image
                class:list={{ "credential-logo--compact": credential.compact }}
                src={credential.src}
                alt={credential.organization}
                width={credential.compact ? 100 : 240}
                densities={[1, 2]}
                loading="lazy"
              />
            </div>
            <p class="credential-category">{credential.category}</p>
            <h3>
              {"href" in credential ? (
                <a class="partner-link" href={credential.href}>
                  {credential.name} <span aria-hidden="true">↗</span>
                </a>
              ) : (
                credential.name
              )}
            </h3>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .credentials {
    padding-block: clamp(40px, 5vw, 64px);
    background: var(--sage-50);
    border-block: 1px solid var(--sage-100);
  }

  .credentials-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .credentials-heading .label {
    color: var(--forest-700);
  }

  .credentials-heading h2 {
    max-width: 620px;
    margin-top: 10px;
    color: var(--forest-800);
    font-size: clamp(1.9rem, 3vw, 2.75rem);
    line-height: 1.15;
  }

  .credentials-heading > p {
    max-width: 320px;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    list-style: none;
    border: 1px solid var(--sage-100);
    border-radius: var(--radius-md);
    background: var(--sage-100);
  }

  .credential {
    min-width: 0;
    padding: 24px 20px 28px;
    text-align: center;
    background: var(--surface);
  }

  .credential-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 104px;
    margin-bottom: 20px;
  }

  .credential-logo img {
    width: auto;
    height: auto;
    max-width: min(100%, 240px);
    max-height: 88px;
    object-fit: contain;
  }

  .credential-logo img.credential-logo--compact {
    max-width: 100px;
  }

  .credential-category {
    margin: 0 0 8px;
    color: var(--rose-700);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .credential h3 {
    color: var(--forest-800);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .partner-link {
    color: var(--forest-800);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .partner-link:hover {
    color: var(--rose-700);
  }

  .partner-link:focus-visible {
    outline: 2px solid var(--forest-800);
    outline-offset: 5px;
  }

  @media (max-width: 900px) {
    .credentials-heading {
      display: block;
    }

    .credentials-heading > p {
      max-width: 540px;
      margin-top: 16px;
    }

    .credential:last-child {
      grid-column: 1 / -1;
    }

    .credentials-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .credential {
      padding: 20px 12px;
    }

    .credential-logo {
      height: 88px;
      margin-bottom: 16px;
    }

    .credential-logo img {
      max-height: 72px;
    }

    .credential h3 {
      font-size: 0.8125rem;
    }

    .credential-category {
      font-size: 0.625rem;
      letter-spacing: 0.025em;
    }
  }
</style>
