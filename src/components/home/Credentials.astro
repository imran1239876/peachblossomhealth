---
/**
 * Certification and membership logos, scrolling as an endless strip (the
 * same strip the current WordPress site shows). Pure CSS: the list is
 * rendered twice and the track slides by exactly one copy, so the loop is
 * seamless. The second copy is aria-hidden; it pauses on hover and stands
 * still for visitors who prefer reduced motion.
 */
import { Image } from "astro:assets";
import abom from "@/assets/home/cert-abom.webp";
import acls from "@/assets/home/cert-acls.webp";
import abfm from "@/assets/home/cert-abfm.webp";
import aafp from "@/assets/home/cert-aafp.webp";

const logos = [
  {
    src: abom,
    alt: "American Board of Obesity Medicine",
    height: 56,
  },
  {
    src: acls,
    alt: "ACLS authorized provider, American Heart Association",
    height: 80,
  },
  {
    src: abfm,
    alt: "Board certified, American Board of Family Medicine",
    height: 72,
  },
  {
    src: aafp,
    alt: "American Academy of Family Physicians",
    height: 64,
  },
];
---

<section class="creds-strip" aria-label="Certifications and memberships">
  <div class="creds-track">
    {
      [0, 1].map((copy) => (
        <ul class="creds-list" aria-hidden={copy === 1 ? "true" : undefined}>
          {logos.map((logo) => (
            <li>
              <Image
                src={logo.src}
                alt={copy === 1 ? "" : logo.alt}
                height={logo.height}
                densities={[1, 2]}
              />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .creds-strip {
    overflow: hidden;
    padding-block: clamp(28px, 4vw, 48px);
    background: var(--surface);
    border-block: 1px solid var(--line);
    /* fade the logos in and out at the edges */
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
  }
  .creds-track {
    display: flex;
    width: max-content;
    animation: creds-scroll 32s linear infinite;
  }
  .creds-strip:hover .creds-track {
    animation-play-state: paused;
  }
  .creds-list {
    display: flex;
    align-items: center;
    gap: clamp(48px, 7vw, 112px);
    padding-right: clamp(48px, 7vw, 112px);
  }
  .creds-list img {
    width: auto;
    max-width: none;
  }
  @keyframes creds-scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .creds-strip {
      mask-image: none;
    }
    .creds-track {
      width: auto;
      animation: none;
    }
    .creds-list {
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      padding-inline: var(--gutter);
      row-gap: 24px;
    }
    .creds-list[aria-hidden] {
      display: none;
    }
  }
</style>
