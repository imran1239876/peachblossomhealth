---
/**
 * Closing banner: the Meet & Greet invitation. Dr. Qureshi's cut-out
 * portrait stands on a soft arch on the right and breaks out above the
 * banner's top edge; a credential tag sits beside her. Decorations are
 * clipped in their own layer so the banner itself can let the photo overflow.
 * On tablet and phone the photo moves below the copy and stays inside.
 */
import { Image } from "astro:assets";
import Icon from "@/components/Icon.astro";
import { PRACTICE } from "@/lib/practice";
import doctor from "@/assets/home/dr-qureshi-cutout.webp";

const steps = [
  {
    title: "Choose Your Service",
    text: "Select from primary care, weight management, or skin treatments for a fully personalized healthcare experience.",
  },
  {
    title: "Flexible Scheduling Options",
    text: "Pick a convenient time that fits your lifestyle and ensures comprehensive care for every visit.",
  },
];
---

<section class="cta2" aria-labelledby="cta-title">
  <div class="container">
    <div class="mg" data-reveal>
      <div class="mg-bg" aria-hidden="true">
        <svg class="mg-bloom" viewBox="0 0 100 100"
          ><use href="#i-blossom-line"></use></svg
        >
      </div>

      <div class="mg-copy">
        <span class="mg-eyebrow">Free Meet &amp; Greet</span>
        <h2 id="cta-title">
          Schedule Your Free Meet &amp; Greet <span>with Dr. Qureshi</span>
        </h2>
        <p class="mg-lead">
          Schedule a visit with Dr. Rabia Qureshi for personalized,
          compassionate care tailored to your health needs.
        </p>
        <ol class="mg-steps">
          {
            steps.map((step, i) => (
              <li>
                <span class="mg-n">{String(i + 1).padStart(2, "0")}</span>
                <strong>{step.title}</strong>
                <span>{step.text}</span>
              </li>
            ))
          }
        </ol>
        <div class="mg-actions">
          <a
            class="btn btn--white btn--lg"
            href={PRACTICE.bookingUrl}
            target="_blank"
            rel="noopener"
            data-cta="book_meet_greet_footer_cta"
            >Schedule Now <Icon name="arrow" size={18} /></a
          >
          <a class="mg-phone" href={PRACTICE.phone.href}>
            <span class="mg-phone-ic"><Icon name="phone" size={18} /></span>
            <span><small>Call or text</small>{PRACTICE.phone.display}</span>
          </a>
        </div>
      </div>

      <div class="mg-visual">
        <span class="mg-arch" aria-hidden="true"></span>
        <Image
          class="mg-doctor"
          src={doctor}
          widths={[480, 960]}
          sizes="(max-width: 1024px) 340px, 560px"
          alt="Dr. Qureshi in her white coat"
        />
        <div class="mg-tag">
          <span class="mg-tag-ic"><Icon name="award" size={18} /></span>
          <span
            ><strong>Dr. Rabia Qureshi, MD</strong>Double board certified</span
          >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mg {
    --breakout: clamp(40px, 5vw, 72px);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    margin-top: var(--breakout);
    border-radius: 40px;
    background:
      radial-gradient(
        90% 80% at 85% 100%,
        rgba(255, 255, 255, 0.16),
        rgba(255, 255, 255, 0) 60%
      ),
      linear-gradient(135deg, #bf5d5e 0%, var(--rose-500) 45%, #8f3b3c 100%);
    color: rgba(255, 255, 255, 0.86);
    box-shadow: 0 40px 80px -48px rgba(115, 47, 48, 0.7);
  }

  /* decorations live in their own clipped layer */
  .mg-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }
  .mg-bloom {
    position: absolute;
    left: -140px;
    bottom: -180px;
    width: 480px;
    height: 480px;
    color: #fff;
    opacity: 0.14;
    animation: ringSpin 90s linear infinite;
  }

  /* ---------- copy ---------- */
  .mg-copy {
    position: relative;
    display: grid;
    gap: 18px;
    align-content: center;
    padding: clamp(40px, 4.5vw, 64px) clamp(16px, 2vw, 32px)
      clamp(40px, 4.5vw, 64px) clamp(40px, 5.5vw, 80px);
  }
  .mg-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #ffd9d6;
  }
  .mg-eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: currentColor;
  }
  .mg h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(2.2rem, 3.4vw, 3.1rem);
    line-height: 1.06;
  }
  .mg h2 span {
    display: block;
    color: #ffd9d6;
  }
  .mg-lead {
    max-width: 46ch;
    font-size: 1rem;
    line-height: 1.7;
  }

  .mg-steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  .mg-steps li {
    display: grid;
    gap: 4px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.28);
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .mg-n {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    color: #ffd9d6;
    -webkit-text-stroke: 0.02em currentColor;
  }
  .mg-steps strong {
    margin-top: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #fff;
  }

  .mg-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 8px;
  }
  .mg-actions .btn--white {
    color: var(--rose-700);
    box-shadow: 0 14px 30px -14px rgba(60, 15, 15, 0.6);
  }
  .mg-phone {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .mg-phone:hover {
    color: #fff;
  }
  .mg-phone-ic {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    transition: background-color 0.2s ease;
  }
  .mg-phone:hover .mg-phone-ic {
    background: rgba(255, 255, 255, 0.14);
  }
  .mg-phone small {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
  }

  /* ---------- portrait ---------- */
  .mg-visual {
    position: relative;
    min-height: 100%;
  }
  .mg-arch {
    position: absolute;
    left: 54%;
    bottom: 0;
    width: min(72%, 400px);
    height: 82%;
    border-radius: 999px 999px 0 0;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.26),
      rgba(255, 255, 255, 0.06)
    );
    translate: -50% 0;
  }
  /* anchored right: the photo's own transparent margin keeps the figure
     inside the banner, and it rises above the top edge by --breakout */
  .mg-doctor {
    position: absolute;
    right: -4%;
    bottom: 0;
    width: auto;
    max-width: none;
    height: calc(100% + var(--breakout));
    filter: drop-shadow(0 30px 40px rgba(60, 15, 15, 0.35));
  }
  .mg-tag {
    position: absolute;
    left: 0;
    bottom: 7%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px 12px 12px;
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: var(--shadow-lift);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text);
  }
  .mg-tag strong {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
  }
  .mg-tag-ic {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--rose-50);
    color: var(--rose-500);
  }

  /* ---------- tablet & phone: photo below the copy, kept inside ---------- */
  @media (max-width: 1024px) {
    .mg {
      grid-template-columns: 1fr;
      margin-top: 0;
    }
    .mg-copy {
      padding: clamp(32px, 6vw, 56px);
      padding-bottom: 24px;
    }
    .mg-visual {
      height: clamp(320px, 70vw, 440px);
    }
    .mg-doctor {
      right: auto;
      left: 50%;
      height: 100%;
      translate: -50% 0;
    }
    .mg-arch {
      left: 50%;
      width: min(70%, 340px);
    }
    .mg-tag {
      left: 16px;
      bottom: 24px;
    }
  }
  @media (max-width: 680px) {
    .mg {
      border-radius: 28px;
    }
    .mg-steps {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .mg-tag {
      left: 12px;
      bottom: 16px;
      padding: 10px 14px 10px 10px;
      font-size: 0.75rem;
    }
  }
</style>
