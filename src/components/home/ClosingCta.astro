---
/**
 * Closing CTA: a slim band, deliberately not a second hero. By this point the
 * visitor has read the page, so it is one line of invitation, a small avatar
 * of Dr. Qureshi for a personal touch, and the two ways to book.
 */
import { Image } from "astro:assets";
import Icon from "@/components/Icon.astro";
import { PRACTICE } from "@/lib/practice";
import avatar from "@/assets/home/dr-qureshi-avatar.webp";
---

<section class="cta2" aria-labelledby="cta-title">
  <div class="container">
    <div class="band" data-reveal>
      <svg class="band-bloom" viewBox="0 0 100 100" aria-hidden="true"
        ><use href="#i-blossom-line"></use></svg
      >

      <div class="band-intro">
        <Image
          class="band-avatar"
          src={avatar}
          alt=""
          width={72}
          densities={[1, 1.5]}
        />
        <div>
          <h2 id="cta-title">
            Schedule Your Free Meet &amp; Greet <span>with Dr. Qureshi</span>
          </h2>
          <p>Personalized, compassionate care tailored to your health needs.</p>
        </div>
      </div>

      <div class="band-actions">
        <a
          class="btn btn--white"
          href={PRACTICE.bookingUrl}
          target="_blank"
          rel="noopener"
          data-cta="book_meet_greet_footer_cta"
          >Schedule Now <Icon name="arrow" /></a
        >
        <a class="band-phone" href={PRACTICE.phone.href}
          ><Icon name="phone" size={16} />Call or text {
            PRACTICE.phone.display
          }</a
        >
      </div>
    </div>
  </div>
</section>

<style>
  /* a closing note needs less air than a full section */
  .cta2 {
    padding-block: clamp(48px, 6vw, 88px);
  }

  .band {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    padding: clamp(28px, 3.5vw, 44px) clamp(28px, 4.5vw, 56px);
    border-radius: 32px;
    background: linear-gradient(
      120deg,
      #bf5d5e 0%,
      var(--rose-500) 50%,
      #8f3b3c 100%
    );
    color: rgba(255, 255, 255, 0.86);
    box-shadow: 0 30px 60px -40px rgba(115, 47, 48, 0.7);
  }
  .band-bloom {
    position: absolute;
    right: 18%;
    top: 50%;
    width: 300px;
    height: 300px;
    color: #fff;
    opacity: 0.1;
    translate: 0 -50%;
    pointer-events: none;
    animation: ringSpin 90s linear infinite;
  }

  .band-intro {
    position: relative;
    display: flex;
    align-items: center;
    gap: 22px;
    min-width: 0;
  }
  .band-avatar {
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.85);
  }
  .band h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.6rem, 2.4vw, 2.25rem);
    line-height: 1.12;
  }
  .band h2 span {
    color: #ffd9d6;
  }
  .band-intro p {
    margin-top: 6px;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .band-actions {
    position: relative;
    flex: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
  }
  .band-actions .btn--white {
    color: var(--rose-700);
    box-shadow: 0 12px 26px -14px rgba(60, 15, 15, 0.6);
  }
  .band-phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .band-phone:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* tablet: stack, actions under the copy */
  @media (max-width: 1024px) {
    .band {
      flex-direction: column;
      align-items: flex-start;
    }
    .band-actions {
      padding-left: 94px; /* line up with the heading, past the avatar */
    }
  }
  /* phone: centre everything, full-width button */
  @media (max-width: 680px) {
    .band {
      align-items: stretch;
      text-align: center;
      border-radius: 24px;
    }
    .band-intro {
      flex-direction: column;
      gap: 14px;
    }
    .band-actions {
      flex-direction: column;
      padding-left: 0;
    }
    .band-actions .btn {
      width: 100%;
    }
    .band-bloom {
      right: -80px;
    }
  }
</style>
