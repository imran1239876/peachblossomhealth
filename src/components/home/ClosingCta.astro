---
/**
 * Closing CTA: a slim band, deliberately not a second hero. Dr. Qureshi's
 * cut-out portrait is cropped to head and shoulders on the left: she rises a
 * little above the band on a soft halo and is cut off at the band's bottom
 * edge. Beside her, one line of invitation and the two ways to book.
 *
 * The decorations sit in their own clipped layer so the band itself can let
 * the portrait out of the top; the portrait's own wrapper clips the bottom.
 */
import { Image } from "astro:assets";
import Icon from "@/components/Icon.astro";
import { PRACTICE } from "@/lib/practice";
import doctor from "@/assets/home/dr-qureshi-cutout.webp";
---

<section class="cta2" aria-labelledby="cta-title">
  <div class="container">
    <div class="band" data-reveal>
      <div class="band-bg" aria-hidden="true">
        <svg class="band-bloom" viewBox="0 0 100 100"
          ><use href="#i-blossom-line"></use></svg
        >
      </div>

      <div class="band-photo">
        <span class="band-halo" aria-hidden="true"></span>
        <Image
          class="band-doctor"
          src={doctor}
          widths={[360, 720]}
          sizes="360px"
          alt="Dr. Qureshi in her white coat"
        />
      </div>

      <div class="band-copy">
        <h2 id="cta-title">
          Schedule Your Free Meet &amp; Greet <span>with Dr. Qureshi</span>
        </h2>
        <p>Personalized, compassionate care tailored to your health needs.</p>
      </div>

      <div class="band-actions">
        <a
          class="btn btn--white"
          href={PRACTICE.bookingUrl}
          target="_blank"
          rel="noopener"
          data-cta="book_meet_greet_footer_cta"
          >Schedule Now <Icon name="arrow" /></a
        >
        <a class="band-phone" href={PRACTICE.phone.href}
          ><Icon name="phone" size={16} />Call or text {
            PRACTICE.phone.display
          }</a
        >
      </div>
    </div>
  </div>
</section>

<style>
  /* a closing note needs less air than a full section */
  .cta2 {
    padding-block: clamp(48px, 6vw, 88px);
  }

  .band {
    --rise: 64px; /* how far the portrait rises above the band */
    --band-radius: 32px;
    position: relative;
    display: grid;
    grid-template-columns: 290px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 40px;
    min-height: 210px;
    margin-top: var(--rise);
    padding-right: clamp(28px, 4.5vw, 56px);
    border-radius: var(--band-radius);
    background: linear-gradient(
      120deg,
      #bf5d5e 0%,
      var(--rose-500) 50%,
      #8f3b3c 100%
    );
    color: rgba(255, 255, 255, 0.86);
    box-shadow: 0 30px 60px -40px rgba(115, 47, 48, 0.7);
  }
  .band-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }
  .band-bloom {
    position: absolute;
    right: 22%;
    top: 50%;
    width: 300px;
    height: 300px;
    color: #fff;
    opacity: 0.1;
    translate: 0 -50%;
    animation: ringSpin 90s linear infinite;
  }

  /* ---------- portrait ---------- */
  .band-photo {
    position: relative;
    align-self: stretch;
    /* open at the top (the portrait rises out), cut at the band's bottom
       edge, rounded to match the band's bottom-left corner */
    clip-path: inset(
      calc(-1 * var(--rise) - 24px) -40px 0 0 round 0 0 0 var(--band-radius)
    );
  }
  .band-halo {
    position: absolute;
    left: 50%;
    bottom: -56px;
    width: 236px;
    height: 236px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.24),
      rgba(255, 255, 255, 0.08) 70%
    );
    translate: -50% 0;
  }
  .band-doctor {
    position: absolute;
    left: 50%;
    bottom: -72px;
    width: auto;
    max-width: none;
    height: calc(100% + var(--rise) + 72px);
    translate: -50% 0;
    filter: drop-shadow(0 18px 28px rgba(60, 15, 15, 0.35));
  }

  /* ---------- copy & actions ---------- */
  .band-copy {
    position: relative;
    padding-block: 36px;
  }
  .band h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.6rem, 2.3vw, 2.1rem);
    line-height: 1.12;
  }
  .band h2 span {
    color: #ffd9d6;
  }
  .band-copy p {
    margin-top: 8px;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .band-actions {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding-block: 36px;
  }
  .band-actions .btn--white {
    color: var(--rose-700);
    box-shadow: 0 12px 26px -14px rgba(60, 15, 15, 0.6);
  }
  .band-phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .band-phone:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ---------- tablet: actions drop under the copy ---------- */
  @media (max-width: 1100px) {
    .band {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 0 32px;
    }
    .band-photo {
      grid-row: span 2;
    }
    .band-copy {
      align-self: end;
      padding-block: 36px 0;
    }
    .band-actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-self: start;
      gap: 14px 24px;
      padding-block: 20px 36px;
    }
  }

  /* ---------- phone: portrait on top, everything centred ---------- */
  @media (max-width: 680px) {
    .band {
      --rise: 48px;
      --band-radius: 24px;
      grid-template-columns: minmax(0, 1fr);
      padding-right: 0;
      text-align: center;
    }
    .band-photo {
      grid-row: auto;
      height: 190px;
      clip-path: inset(calc(-1 * var(--rise) - 24px) 0 0 0);
    }
    /* fade the portrait out where the copy begins */
    .band-doctor {
      bottom: -40px;
      height: calc(100% + var(--rise) + 40px);
      mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
    }
    .band-halo {
      width: 200px;
      height: 200px;
      bottom: -40px;
    }
    .band-copy {
      padding: 18px 24px 0;
    }
    .band-actions {
      flex-direction: column;
      padding: 20px 24px 28px;
    }
    .band-actions .btn {
      width: 100%;
    }
    .band-bloom {
      right: -90px;
    }
  }
</style>
