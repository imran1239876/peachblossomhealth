# ---------------------------------------------------------------------------
# BUILD-time environment variables (Astro / Vite `import.meta.env`).
#
# Copy this file to `.env` (which is gitignored) to override the defaults in
# src/config.ts without editing code.
#
# `.env` is NOT `.dev.vars`. They are two different mechanisms, read at two
# different times, and mixing them up fails quietly:
#
#                  .env  (this file)          .dev.vars / Worker Secrets
#   Read when      the site is BUILT          the WORKER RUNS
#   Ends up        baked into the bundle      in the Worker's secret store
#   May hold       NON-SECRET config only     SECRETS only
#   In production  build environment vars     `wrangler secret put <NAME>`
#                  (Cloudflare dashboard →
#                  Worker → Settings → Build,
#                  or your CI)
#   Holds here     PUBLIC_TURNSTILE_SITE_KEY  TURNSTILE_SECRET
#                  PORTAL_API_BASE            PORTAL_ORG_KEY
#                                             Z360_TOKEN
#
# So: never put a secret in this file or in `.env` — anything here is either
# shipped to the browser or embedded in the deployed Worker bundle, and neither
# can be taken back. And never try to `wrangler secret put` one of the two
# variables below: a Worker Secret is a runtime value that simply does not
# exist yet at build time, so the build would fall back to the default and the
# override would silently do nothing. See .dev.vars.example for the runtime
# side.
#
# Both variables below are OPTIONAL: src/config.ts falls back to working
# defaults, so a fresh clone builds and runs with no `.env` at all.
# ---------------------------------------------------------------------------

# Cloudflare Turnstile SITE key — the PUBLIC half of the widget pair.
#
# It is public by design: the widget renders in the browser, so this value is
# served to every visitor no matter where it is stored. The `PUBLIC_` prefix is
# what makes Astro expose it to client-side code, and it is *required* for the
# form island to see it. Do not "promote" this to a Worker Secret — a
# prerendered page cannot read one.
#
# Leave it unset (or delete the line) to use Cloudflare's "always passes" TEST
# sitekey from src/config.ts, which pairs with the test secret in
# .dev.vars.example so a fresh clone has a working form. Before launch, set the
# real sitekey here or in the build environment, and make sure its widget lists
# every hostname the site is served from — apex, www, localhost, 127.0.0.1.
PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Origin of the Zikra portal that receives every lead — no trailing slash.
#
# Only the server-side Astro Action ever builds a submit URL from this, which
# is why it carries no `PUBLIC_` prefix: the value is inlined into the Worker
# bundle and never needs to reach the browser. Override it to point a preview
# or staging build at a staging portal.
#
# The per-form endpoint key that completes the URL lives in the FORMS registry
# in src/config.ts (endpoint keys are routing, not secrets). The credential
# that authenticates the push is the organization's `pok_…` API key in
# PORTAL_ORG_KEY — a real secret, so it belongs in .dev.vars / Worker Secrets
# and never in this file.
# PORTAL_API_BASE="https://portal.z360.cloud"
